DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/creator_universe?schema=public"
# PortOne V2 (server only). Use a separate test store/database for integration testing.
PORTONE_MODE=test
PORTONE_STORE_ID=""
PORTONE_API_SECRET=""
PORTONE_PAYMENT_CHANNEL_KEY=""
PORTONE_IDENTITY_CHANNEL_KEY=""
PORTONE_WEBHOOK_SECRET=""
# Enable after a successful signup test using the configured identity channel.
PORTONE_IDENTITY_REQUIRED=false
# Kakao and Naver apps each need their exact Vercel callback. See docs/easy-login.md.
KAKAO_REST_API_KEY=""
KAKAO_CLIENT_SECRET=""
# Primary app admin key for Kakao's signed-header callback and server-side unlink.
KAKAO_ADMIN_KEY=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
# PASS login needs a live identity channel that returns verifiedCustomer.ci.
# Generate a separate random secret of at least 32 bytes and keep it stable across deploys.
EASY_LOGIN_HMAC_SECRET=""
PORT=4000
# Comma-separated origins allowed to call the API in browsers.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://project-limyoobins-projects.vercel.app"

# Development-only convenience. Keep this false in production.
ALLOW_INSECURE_USER_CONTEXT=false

# Optional file upload settings.
# On Synology, point this to a shared folder mounted into the backend container.
UPLOAD_DIR="./uploads"
JSON_BODY_LIMIT="40mb"
# PUBLIC_API_URL="https://your-api.example.com"

# Optional server-side reviews. Set keys only for the providers your deployment uses.
# Empty keys leave local matching active. Keep these values out of frontend/VITE_*.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
NVIDIA_API_KEY=""
NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# Model allowlist only. Actual charges depend on each provider account's billing.
GEMINI_FREE_ONLY=true

# Each provider accepts the same optional suffixes. Replace GROQ with NVIDIA or GEMINI.
# GROQ_AI_ENABLED=false
# GROQ_DAILY_REQUEST_LIMIT=40
# GROQ_MIN_INTERVAL_MS=1500
# GROQ_TIMEOUT_MS=7000
# GROQ_MAX_INPUT_CHARS=5200
# GROQ_MAX_OUTPUT_TOKENS=650

# Optional. Set these only when you intentionally want to create/update an admin account.
# Never use weak sample passwords in production.
# ROOT_ADMIN_USERNAME=root
# ROOT_ADMIN_PASSWORD=replace-with-a-long-unique-password
# ROOT_ADMIN_EMAIL=root@creator-universe.local
